rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /contactRequests/{requestId} {
      allow read: if request.auth != null && (
        requestId.split('_')[0] == request.auth.uid ||
        requestId.split('_')[1] == request.auth.uid ||
        resource.data.senderId == request.auth.uid ||
        resource.data.receiverId == request.auth.uid
      );
      allow create: if request.auth != null &&
        request.resource.data.senderId == request.auth.uid;
      allow update: if request.auth != null && (
        resource.data.senderId == request.auth.uid ||
        resource.data.receiverId == request.auth.uid
      );
      allow delete: if request.auth != null && (
        resource.data.senderId == request.auth.uid ||
        resource.data.receiverId == request.auth.uid
      );
    }

    match /users/{userId}/contacts/{contactId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null && (
        request.auth.uid == userId ||
        canWriteReciprocalContact(userId, contactId)
      );
      allow delete: if request.auth != null && (
        request.auth.uid == userId ||
        canDeleteReciprocalContact(userId, contactId)
      );
    }

    match /users/{userId}/channels/{channelId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Path: chats/{uid1_uid2}/messages/{msgId}
    match /chats/{chatId}/messages/{msgId} {
      allow read, write: if request.auth != null &&
        (chatId.split('_')[0] == request.auth.uid ||
         chatId.split('_')[1] == request.auth.uid);
    }

    // Path: channels/{uid_channelName}/messages/{msgId}
    match /channels/{channelDoc}/messages/{msgId} {
      allow read, write: if request.auth != null &&
        channelDoc.split('_')[0] == request.auth.uid;
    }

    // Path: typing/{chatId}
    match /typing/{chatId} {
      allow read, write: if request.auth != null &&
        (chatId.split('_')[0] == request.auth.uid ||
         chatId.split('_')[1] == request.auth.uid);
    }

    // Path: readReceipts/{chatId}
    match /readReceipts/{chatId} {
      allow read, write: if request.auth != null &&
        (chatId.split('_')[0] == request.auth.uid ||
         chatId.split('_')[1] == request.auth.uid);
    }

    function canWriteReciprocalContact(userId, contactId) {
      return request.auth.uid == contactId &&
        request.resource.data.contactUid == contactId &&
        acceptedContactRequestExists(userId, contactId);
    }

    function canDeleteReciprocalContact(userId, contactId) {
      return request.auth.uid == contactId &&
        acceptedContactRequestExists(userId, contactId);
    }

    function acceptedContactRequestExists(userId, contactId) {
      return (
        exists(/databases/$(database)/documents/contactRequests/$(userId + "_" + contactId)) &&
        get(/databases/$(database)/documents/contactRequests/$(userId + "_" + contactId)).data.status == "accepted"
      ) || (
        exists(/databases/$(database)/documents/contactRequests/$(contactId + "_" + userId)) &&
        get(/databases/$(database)/documents/contactRequests/$(contactId + "_" + userId)).data.status == "accepted"
      );
    }
  }
}
