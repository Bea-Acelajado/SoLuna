rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Users collection ──────────────────────────────────────────
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // ── Contact Requests ─────────────────────────────────────────
    match /contactRequests/{requestId} {
      allow read: if request.auth != null && (
        requestId.split('_')[0] == request.auth.uid ||
        requestId.split('_')[1] == request.auth.uid
      );
      allow create: if request.auth != null &&
        request.resource.data.senderId == request.auth.uid;
      allow update: if request.auth != null && (
        resource.data.senderId == request.auth.uid ||
        resource.data.receiverId == request.auth.uid
      );
      allow delete: if request.auth != null && (
        resource.data.senderId == request.auth.uid ||
        resource.data.receiverId == request.auth.uid
      );
    }

    // ── Contacts Subcollection ────────────────────────────────────
    match /users/{userId}/contacts/{contactId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ── Two-user Contact Chats ────────────────────────────────────
    // Path: chats/{uid1_uid2}/messages/{msgId}
    match /chats/{chatId}/messages/{msgId} {
      allow read, write: if request.auth != null &&
        (chatId.split('_')[0] == request.auth.uid || 
         chatId.split('_')[1] == request.auth.uid);
    }

    // ── Personal Channels (notepad) ───────────────────────────────
    // Path: channels/{uid_channelName}/messages/{msgId}
    match /channels/{channelDoc}/messages/{msgId} {
      allow read, write: if request.auth != null &&
        channelDoc.split('_')[0] == request.auth.uid;
    }

    // ── Typing Indicators ─────────────────────────────────────────
    // Path: typing/{chatId}  (flat doc, fields keyed by uid)
    match /typing/{chatId} {
      allow read, write: if request.auth != null &&
        (chatId.split('_')[0] == request.auth.uid || 
         chatId.split('_')[1] == request.auth.uid);
    }

    // ── Read Receipts ─────────────────────────────────────────────
    // Path: readReceipts/{chatId}  (flat doc, fields keyed by uid)
    match /readReceipts/{chatId} {
      allow read, write: if request.auth != null &&
        (chatId.split('_')[0] == request.auth.uid || 
         chatId.split('_')[1] == request.auth.uid);
    }
  }
}
